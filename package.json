{
  "name": "gopca-monorepo",
  "private": true,
  "description": "GoPCA monorepo containing shared UI components and applications",
  "workspaces": [
    "packages/ui-components",
    "cmd/gopca-desktop/frontend",
    "cmd/gocsv/frontend"
  ],
  "scripts": {
    "install-all": "npm install",
    "build-ui": "npm run build -w @gopca/ui-components",
    "build-gopca": "npm run build -w frontend",
    "build-gocsv": "npm run build -w gocsv-frontend",
    "build-all": "npm run build-ui && npm run build-gopca && npm run build-gocsv",
    "dev-ui": "npm run dev -w @gopca/ui-components",
    "dev-gopca": "npm run dev -w frontend",
    "dev-gocsv": "npm run dev -w gocsv-frontend",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "yaml": "2.8.4",
    "js-yaml": "4.1.1",
    "mdast-util-to-hast": "13.2.1",
    "rollup": "4.60.4",
    "protocol-buffers-schema": "3.6.1",
    "ajv@<6.14.0": "6.15.0",
    "picomatch@<2.3.2": "2.3.2",
    "minimatch@>=3.0.0 <4.0.0": "3.1.5",
    "minimatch@>=9.0.0 <10.0.0": "9.0.9",
    "brace-expansion@<1.1.13": "1.1.14",
    "brace-expansion@>=2.0.0 <2.0.3": "2.1.0",
    "glob@>=10.2.0 <10.5.0": "10.5.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.9.2"
  }
}
