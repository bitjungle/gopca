<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="bitjungle.GoPCA"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}" />

  <Properties>
    <DisplayName>GoPCA</DisplayName>
    <PublisherDisplayName>bitjungle</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="GoPCA" Executable="GoPCA.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GoPCA"
        Description="Principal Component Analysis Toolkit for Data Scientists and Researchers"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
    <Application Id="GoCSV" Executable="GoCSV.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GoCSV"
        Description="CSV Data Preparation Tool for GoPCA Suite"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\GoCSV_Square150x150Logo.png"
        Square44x44Logo="Assets\GoCSV_Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
