.DS_Store
.gitconfig

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.vscode/

# Claude
.claude/
CLAUDE.md
CLAUDE.md.bak
CLAUDE-backup*.md
docs/CLAUDE.md
docs/devel/milestone_*.md
.mcp.json
.serena

# Local documentation
docs_tmp/
# Keep reference summaries but ignore PDFs
docs/references/*.pdf
!docs/references/_summaries.txt

# Build artifacts
results/

# Only ignore the binary outputs, not build configuration
cmd/gopca-desktop/build/bin/
cmd/gocsv/build/bin/

# Legacy build directory if it exists elsewhere
build/
cmd/gocsv/gocsv

# Node modules
node_modules/

# Python 
__pycache__/
.venv/
# Screenshots and temporary images
Skjermbilde*.png
Screenshot*.png
*.tmp.png

# Certificate files (never commit!)
.certs/
*.p12
*.pfx

# MSIX packaging artifacts
cmd/gopca-desktop/AppxManifest.xml
*.msix
*.appx

# Misc. temp files
_tmp/
testdata/wine/plotly/
testdata/validation/reference_results

# Internal milestone planning docs (not for public repo)
docs/devel/milestone_*.md
